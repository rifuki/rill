# Public deployment configuration. Keep secrets in the process secret manager.
SUI_NETWORK=mainnet
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
PUBLIC_BASE_URL=https://api.rill.naisu.one
RILL_CONSENT_URL=https://rill.naisu.one/authorize
AGENT_WALLET_PACKAGE_ID=
AGENT_WALLET_VERSION_ID=
RILL_GUARD_PACKAGE_ID=
# Signing remains opt-in after all MAINNET.md gates are satisfied.
RILL_ALLOW_MAINNET=false
# Frontend build configuration must select the same network.
VITE_SUI_NETWORK=mainnet
VITE_RILL_API_URL=https://api.rill.naisu.one/api
